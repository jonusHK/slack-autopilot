# 이름만 담는다. 값이 들어가면 안 된다(커밋되는 파일).
# 실제 값은 .env(gitignore) 또는 클라우드 환경의 환경변수에만 둔다.

# Slack 봇 토큰 (xoxb-…)
# 스코프: channels:history · reactions:read · reactions:write · chat:write
SLACK_BOT_TOKEN=

# 감시할 프로젝트 — 접미사 목록. 비우면 접미사 없는 단일 프로젝트로 본다.
#   AUTOPILOT_PROJECTS=SAI,SHOP  →  SLACK_CHANNEL_ID_SAI · TARGET_REPO_SAI · …
# 프로젝트를 추가할 때 트리거를 새로 만들지 않는다 — 여기에 접미사만 늘린다(D-011).
AUTOPILOT_PROJECTS=

# 감시할 채널 ID (프로젝트별이면 _SAI 처럼 접미사를 붙인다)
SLACK_CHANNEL_ID=

# ▶️·🚀 를 붙일 수 있는 사람의 슬랙 사용자 ID(쉼표 구분).
# **이름이 맞아도 이 목록 밖의 사람이 붙인 이모지는 없는 것으로 본다.**
# 채널 멤버 누구나 봇에게 코드를 쓰게 만드는 것을 막는 유일한 게이트다.
# 비워 두면 검출이 아무것도 집지 않고 에러로 멈춘다(빠뜨렸을 때 꺼지는 쪽).
SLACK_HUMAN_USERS=

# 작업 대상 레포 (owner/repo) — 채널과 짝이다. 접미사 규약 동일.
TARGET_REPO=

# GitHub 토큰 — **CI 상태를 읽으려면 필요하다.**
# 실측(2026-08-17): 레포가 세션에 붙어 있으면 프록시가 자격을 붙여 줘서
# 클론·push·PR 조회는 토큰 없이도 200 이다. 그런데 CI 상태 조회만은 403 이었다
# (`Resource not accessible by integration` — 프록시의 App 자격으로는 안 읽힌다).
# CI 상태는 자기 수정 루프의 눈이라 없으면 4단계가 그 자리에서 멈춘다.
# fine-grained PAT, 대상 레포로만 한정, 권한 넷:
#   Contents 읽기·쓰기 / Pull requests 읽기·쓰기 / Actions 읽기 / Commit statuses 읽기
GH_TOKEN=

# 엔진 레포의 클론 URL. 프라이빗이면 토큰을 포함한 형태를 쓴다:
#   https://<TOKEN>@github.com/<owner>/slack-autopilot.git
# 퍼블릭이면 그냥 https://github.com/<owner>/slack-autopilot.git
ENGINE_REPO_URL=
