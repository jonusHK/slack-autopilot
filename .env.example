# 이름만 담는다. 값이 들어가면 안 된다(커밋되는 파일).
# 실제 값은 .env(gitignore) 또는 클라우드 환경의 환경변수에만 둔다.

# Slack 봇 토큰 (xoxb-…)
# 스코프: channels:history · reactions:read · reactions:write · chat:write
SLACK_BOT_TOKEN=

# 감시할 채널 ID
SLACK_CHANNEL_ID=

# 작업 대상 레포 (owner/repo)
TARGET_REPO=

# GitHub 토큰 — **클라우드 루틴에서는 비워 둔다.**
# 루틴에 대상 레포를 붙이면 프록시가 자격을 붙여 주므로 토큰이 필요 없다(실측 2026-08-17).
# 안 쓰는 시크릿을 환경에 두는 것이 더 나쁘다 — 환경변수는 그 환경을 쓰는 누구나 읽는다.
# 로컬에서 스크립트를 직접 돌릴 때만 채운다(그때는 fine-grained PAT:
#   Contents 읽기·쓰기 / Pull requests 읽기·쓰기 / Actions 읽기).
GH_TOKEN=

# 엔진 레포의 클론 URL. 프라이빗이면 토큰을 포함한 형태를 쓴다:
#   https://<TOKEN>@github.com/<owner>/slack-autopilot.git
# 퍼블릭이면 그냥 https://github.com/<owner>/slack-autopilot.git
ENGINE_REPO_URL=
