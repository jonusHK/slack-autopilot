# 이 파일은 **이름만** 담는다. 값이 들어가면 안 된다(커밋되는 파일).
# 실제 값은 .env(gitignore) 또는 클라우드 루틴 시크릿에만 둔다.

# Slack 봇 토큰 (xoxb-…) — 스코프: channels:history, reactions:read, reactions:write, chat:write
SLACK_BOT_TOKEN=

# 대상 채널 ID (프로젝트마다 하나씩 — 이름 규칙: SLACK_CHANNEL_ID_<프로젝트>)
SLACK_CHANNEL_ID_SAI=

# 대상 레포 (owner/repo). 공개 정보지만 설정 일원화를 위해 여기 둔다.
TARGET_REPO_SAI=

# GitHub 토큰 — 클라우드 루틴의 GitHub 연동을 쓰면 불필요.
# 로컬 실행·디버깅 시에만 사용(gh auth 로 대체 가능).
GITHUB_TOKEN=
